{
  "name": "todolist-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace todolist-web-app",
    "mobile": "npm run start --workspace todolist-mob-app",
    "test": "npm run test --workspace @todolist/shared",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
